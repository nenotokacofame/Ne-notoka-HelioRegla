def establecer_idioma(idioma):
    global _idioma
    _idioma = idioma if idioma in IDIOMAS else "es"


def idioma_actual():
    return _idioma


def tr(clave, **valores):
    texto = TEXTOS.get(_idioma, TEXTOS["es"]).get(
        clave,
        TEXTOS["es"].get(clave, clave),
    )
    return texto.format(**valores) if valores else texto

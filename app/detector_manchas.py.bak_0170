from dataclasses import dataclass
from pathlib import Path

import cv2
import numpy as np


class ErrorDeteccionManchas(RuntimeError):
    pass


@dataclass
class CandidataMancha:
    x: float
    y: float
    radio: float
    confianza: float


def _leer_gris(ruta):
    datos = np.fromfile(str(Path(ruta)), dtype=np.uint8)
    imagen = cv2.imdecode(datos, cv2.IMREAD_COLOR)

    if imagen is None:
        raise ErrorDeteccionManchas(
            "No se pudo leer la imagen."
        )

    return cv2.cvtColor(imagen, cv2.COLOR_BGR2GRAY)


def _mascara_util(alto, ancho, circulo, factor):
    mascara = np.full((alto, ancho), 255, dtype=np.uint8)

    if circulo is None:
        return mascara

    mascara.fill(0)
    cx, cy, radio = circulo
    radio_interior = max(4, int(radio * factor * 0.965))
    cv2.circle(
        mascara,
        (
            int(round(cx * factor)),
            int(round(cy * factor)),
        ),
        radio_interior,
        255,
        -1,
    )
    return mascara


def detectar_manchas(ruta, circulo=None, maximo=30):
    gris_original = _leer_gris(ruta)
    alto_original, ancho_original = gris_original.shape
    limite = 1600
    factor = min(
        1.0,
        limite / max(alto_original, ancho_original),
    )

    if factor < 1:
        gris = cv2.resize(
            gris_original,
            None,
            fx=factor,
            fy=factor,
            interpolation=cv2.INTER_AREA,
        )
    else:
        gris = gris_original.copy()

    alto, ancho = gris.shape
    mascara = _mascara_util(alto, ancho, circulo, factor)
    valores = gris[mascara > 0]

    if valores.size < 100:
        raise ErrorDeteccionManchas(
            "No hay suficiente superficie solar para analizar."
        )

    bajo, alto_percentil = np.percentile(valores, (1, 99))
    amplitud = max(float(alto_percentil - bajo), 1.0)
    normalizada = np.clip(
        (gris.astype(np.float32) - bajo) * 255.0 / amplitud,
        0,
        255,
    ).astype(np.uint8)

    dimension = min(alto, ancho)
    kernel_fondo = max(31, int(dimension * 0.045) | 1)
    fondo = cv2.GaussianBlur(
        normalizada,
        (kernel_fondo, kernel_fondo),
        0,
    )
    contraste_oscuro = cv2.subtract(fondo, normalizada)
    contraste_oscuro[mascara == 0] = 0

    valores_contraste = contraste_oscuro[mascara > 0]
    umbral = max(
        10.0,
        float(np.percentile(valores_contraste, 99.15)),
    )
    binaria = np.zeros_like(contraste_oscuro)
    binaria[
        (contraste_oscuro >= umbral)
        & (mascara > 0)
    ] = 255

    kernel = np.ones((3, 3), dtype=np.uint8)
    binaria = cv2.morphologyEx(
        binaria,
        cv2.MORPH_OPEN,
        kernel,
    )
    binaria = cv2.morphologyEx(
        binaria,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2,
    )

    contornos, _ = cv2.findContours(
        binaria,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE,
    )

    area_imagen = float(alto * ancho)
    area_minima = max(5.0, area_imagen * 0.000003)
    area_maxima = area_imagen * 0.012
    candidatas = []

    for contorno in contornos:
        area = float(cv2.contourArea(contorno))

        if not area_minima <= area <= area_maxima:
            continue

        x, y, w, h = cv2.boundingRect(contorno)
        proporcion = max(w, h) / max(min(w, h), 1)

        if proporcion > 4.5:
            continue

        perimetro = float(cv2.arcLength(contorno, True))
        circularidad = (
            4 * np.pi * area / max(perimetro**2, 1.0)
        )

        if circularidad < 0.08:
            continue

        momentos = cv2.moments(contorno)

        if momentos["m00"] <= 0:
            continue

        cx = momentos["m10"] / momentos["m00"]
        cy = momentos["m01"] / momentos["m00"]
        mascara_contorno = np.zeros_like(binaria)
        cv2.drawContours(
            mascara_contorno,
            [contorno],
            -1,
            255,
            -1,
        )
        intensidad = float(
            cv2.mean(
                contraste_oscuro,
                mask=mascara_contorno,
            )[0]
        )
        confianza = (
            intensidad
            * max(circularidad, 0.1)
            * np.sqrt(area)
        )
        radio = max(
            9.0,
            min(
                dimension * 0.025,
                0.62 * max(w, h),
            ),
        )
        candidatas.append(
            CandidataMancha(
                x=cx / factor,
                y=cy / factor,
                radio=radio / factor,
                confianza=confianza,
            )
        )

    candidatas.sort(
        key=lambda candidata: candidata.confianza,
        reverse=True,
    )
    seleccionadas = []

    for candidata in candidatas:
        solapa = any(
            np.hypot(
                candidata.x - existente.x,
                candidata.y - existente.y,
            )
            < max(candidata.radio, existente.radio) * 1.2
            for existente in seleccionadas
        )

        if not solapa:
            seleccionadas.append(candidata)

        if len(seleccionadas) >= maximo:
            break

    if not seleccionadas:
        raise ErrorDeteccionManchas(
            "No se encontraron candidatos suficientemente "
            "contrastados. Puedes etiquetarlos manualmente."
        )

    return seleccionadas

from math import hypot, sqrt

import numpy as np
from PySide6.QtCore import QPointF, QLineF, Qt
from PySide6.QtGui import QColor, QFont, QPen
from PySide6.QtWidgets import (
    QGraphicsEllipseItem,
    QGraphicsItem,
    QGraphicsLineItem,
    QGraphicsSimpleTextItem,
)
from i18n import tr


DIAMETRO_TIERRA_KM = 12_742.0
DIAMETRO_LUNA_KM = 3_474.8


class LineaMedicion(QGraphicsLineItem):
    def __init__(self, medicion):
        super().__init__()
        self.medicion = medicion
        self.setCursor(Qt.PointingHandCursor)

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton:
            self.medicion.notificar_inicio_cambio()
            self.medicion.eliminar()
            event.accept()
            return

        if event.button() == Qt.LeftButton:
            event.accept()
            return

        super().mousePressEvent(event)


class EtiquetaMedicion(QGraphicsSimpleTextItem):
    def __init__(self, medicion):
        super().__init__()
        self.medicion = medicion
        self.setCursor(Qt.PointingHandCursor)
        self.setFlag(
            QGraphicsItem.ItemIgnoresTransformations,
            True,
        )

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton:
            self.medicion.notificar_inicio_cambio()
            self.medicion.eliminar()
            event.accept()
            return

        super().mousePressEvent(event)


class ManejadorProtuberancia(QGraphicsEllipseItem):
    def __init__(self, medicion):
        super().__init__(-7, -7, 14, 14)

        self.medicion = medicion
        self.setBrush(QColor("#ff3dbb"))
        self.setPen(QPen(QColor("#ffffff"), 1))
        self.setCursor(Qt.SizeAllCursor)
        self.setFlag(
            QGraphicsItem.ItemIgnoresTransformations,
            True,
        )
        self.setFlag(
            QGraphicsItem.ItemIsMovable,
            True,
        )
        self.setFlag(
            QGraphicsItem.ItemSendsGeometryChanges,
            True,
        )
        self.setAcceptedMouseButtons(
            Qt.LeftButton | Qt.RightButton
        )
        self.setZValue(52)

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton:
            self.medicion.notificar_inicio_cambio()
            self.medicion.eliminar()
            event.accept()
            return

        if event.button() == Qt.LeftButton:
            self.medicion.notificar_inicio_cambio()

        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        super().mouseMoveEvent(event)
        self.medicion.actualizar(
            self.scenePos(),
            mover_manejador=False,
        )
        event.accept()


class MedicionProtuberancia:
    def __init__(
        self,
        escena,
        circulo_limbo,
        punta,
        km_por_pixel,
        imagen_rect,
        muestras_circulos=None,
        incertidumbre_limbo_px=0.0,
        al_eliminar=None,
        color_anotacion="#ff3dbb",
        tamano_texto=28,
        antes_cambiar=None,
    ):
        self.escena = escena
        self.circulo_limbo = circulo_limbo
        self.km_por_pixel = km_por_pixel
        self.imagen_rect = imagen_rect
        self.muestras_circulos = muestras_circulos or []
        self.incertidumbre_limbo_px = (
            incertidumbre_limbo_px or 0.0
        )
        self.al_eliminar = al_eliminar
        self.color_anotacion = color_anotacion
        self.tamano_texto = tamano_texto
        self.antes_cambiar = antes_cambiar
        self.eliminada = False
        self.punta = QPointF(punta)

        self.linea = LineaMedicion(self)
        lapiz = QPen(QColor("#ff3dbb"), 3)
        lapiz.setCosmetic(True)
        self.linea.setPen(lapiz)
        self.linea.setZValue(50)

        self.manejador = ManejadorProtuberancia(self)

        self.etiqueta = EtiquetaMedicion(self)
        self.etiqueta.setBrush(QColor("#ffffff"))
        self.etiqueta.setZValue(53)

        self.escena.addItem(self.linea)
        self.escena.addItem(self.manejador)
        self.escena.addItem(self.etiqueta)

        self.establecer_estilo(
            self.color_anotacion,
            self.tamano_texto,
        )
        self.actualizar(punta)

    def notificar_inicio_cambio(self):
        if self.antes_cambiar:
            self.antes_cambiar()

    def establecer_estilo(self, color, tamano_texto):
        self.color_anotacion = color
        self.tamano_texto = tamano_texto

        color_qt = QColor(color)

        lapiz = QPen(color_qt, 3)
        lapiz.setCosmetic(True)
        lapiz.setStyle(Qt.CustomDashLine)
        lapiz.setDashPattern([4.0, 3.0])
        self.linea.setPen(lapiz)

        self.manejador.setBrush(color_qt)
        self.etiqueta.setBrush(color_qt)
        fuente = QFont("Century Gothic")
        fuente.setPixelSize(int(tamano_texto))
        fuente.setBold(True)
        self.etiqueta.setFont(fuente)

        if self.manejador.scene() is not None:
            self.colocar_etiqueta(
                self.manejador.scenePos()
            )

    def calcular_incertidumbre_local(self, punta):
        if self.muestras_circulos:
            alturas = []

            for cx, cy, radio in self.muestras_circulos:
                altura = hypot(
                    punta.x() - cx,
                    punta.y() - cy,
                ) - radio
                alturas.append(altura)

            dispersion_local = float(
                np.std(alturas, ddof=1)
            )
        else:
            dispersion_local = self.incertidumbre_limbo_px

        return sqrt(1.5**2 + dispersion_local**2)

    def colocar_etiqueta(self, punta):
        margen = 10
        desplazamiento = 14
        caja = self.etiqueta.boundingRect()

        x = punta.x() + desplazamiento
        y = punta.y() - caja.height() - desplazamiento

        if x + caja.width() > self.imagen_rect.right() - margen:
            x = punta.x() - caja.width() - desplazamiento

        if x < self.imagen_rect.left() + margen:
            x = self.imagen_rect.left() + margen

        if y < self.imagen_rect.top() + margen:
            y = punta.y() + desplazamiento

        if y + caja.height() > self.imagen_rect.bottom() - margen:
            y = self.imagen_rect.bottom() - caja.height() - margen

        self.etiqueta.setPos(x, y)

    def actualizar(self, punta, mover_manejador=True):
        self.punta = QPointF(punta)
        centro = self.circulo_limbo.scenePos()
        radio = self.circulo_limbo.radio

        dx = punta.x() - centro.x()
        dy = punta.y() - centro.y()
        distancia_centro = hypot(dx, dy)

        if distancia_centro < 0.001:
            return

        ux = dx / distancia_centro
        uy = dy / distancia_centro

        base = QPointF(
            centro.x() + radio * ux,
            centro.y() + radio * uy,
        )

        altura_px = max(0.0, distancia_centro - radio)
        altura_km = altura_px * self.km_por_pixel

        incertidumbre_px = (
            self.calcular_incertidumbre_local(punta)
        )
        incertidumbre_km = (
            incertidumbre_px * self.km_por_pixel
        )

        tierras = altura_km / DIAMETRO_TIERRA_KM
        lunas = altura_km / DIAMETRO_LUNA_KM

        self.linea.setLine(QLineF(base, punta))

        if mover_manejador:
            self.manejador.setPos(punta)

        self.etiqueta.setText(
            f"{altura_km:,.0f} ± {incertidumbre_km:,.0f} km\n"
            f"{tierras:.2f} {tr('earths')} · "
            f"{lunas:.1f} {tr('moons')}"
        )
        self.colocar_etiqueta(punta)

    def recalcular_desde_limbo(self):
        if not self.eliminada:
            self.actualizar(self.punta)

    def eliminar(self):
        if self.eliminada:
            return

        self.eliminada = True

        for elemento in (
            self.linea,
            self.manejador,
            self.etiqueta,
        ):
            if elemento.scene() is not None:
                self.escena.removeItem(elemento)

        if self.al_eliminar:
            self.al_eliminar(self)

from pathlib import Path

from PySide6.QtCore import Qt, QUrl
from PySide6.QtGui import QDesktopServices, QPixmap
from PySide6.QtWidgets import (
    QApplication,
    QDialog,
    QDialogButtonBox,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QTabWidget,
    QTextBrowser,
    QVBoxLayout,
    QWidget,
)

from i18n import tr


AUTOR = "David Olivos"
ORGANIZACION = "Ne-notoka Cofame"
CORREO_APOYO = "nenotokacofame@gmail.com"
LICENCIA_SPDX = "GPL-3.0-or-later"

# Se completará con el enlace definitivo de PayPal antes de construir
# el instalador 1.0. El correo de contacto ya queda disponible.
URL_DONATIVOS = ""


class DialogoAcercaDe(QDialog):
    def __init__(
        self,
        version,
        ruta_logo,
        ruta_licencia,
        pestana=0,
        parent=None,
    ):
        super().__init__(parent)
        self.version = version
        self.ruta_licencia = Path(ruta_licencia)
        self.setWindowTitle(tr("about_window_title"))
        self.resize(680, 570)

        principal = QVBoxLayout(self)
        self.pestanas = QTabWidget()
        self.pestanas.addTab(
            self._crear_acerca_de(ruta_logo),
            tr("about_tab"),
        )
        self.pestanas.addTab(
            self._crear_licencia(),
            tr("license_tab"),
        )
        self.pestanas.addTab(
            self._crear_apoyo(),
            tr("support_tab"),
        )
        self.pestanas.setCurrentIndex(
            min(max(int(pestana), 0), 2)
        )
        principal.addWidget(self.pestanas)

        botones = QDialogButtonBox(QDialogButtonBox.Close)
        botones.button(QDialogButtonBox.Close).setText(
            tr("close")
        )
        botones.rejected.connect(self.reject)
        principal.addWidget(botones)

    def _crear_acerca_de(self, ruta_logo):
        pagina = QWidget()
        layout = QVBoxLayout(pagina)

        cabecera = QHBoxLayout()
        logo = QLabel()
        logo.setFixedSize(112, 112)
        pixmap = QPixmap(str(ruta_logo))
        if not pixmap.isNull():
            logo.setPixmap(
                pixmap.scaled(
                    106,
                    106,
                    Qt.KeepAspectRatio,
                    Qt.SmoothTransformation,
                )
            )
        logo.setAlignment(Qt.AlignCenter)

        textos = QVBoxLayout()
        titulo = QLabel(
            f"<h2>Ne-notoka HelioRegla {self.version}</h2>"
        )
        titulo.setTextFormat(Qt.RichText)
        descripcion = QLabel(tr("about_description"))
        descripcion.setWordWrap(True)
        textos.addWidget(titulo)
        textos.addWidget(descripcion)
        textos.addStretch(1)

        cabecera.addWidget(logo)
        cabecera.addLayout(textos, 1)
        layout.addLayout(cabecera)

        detalles = QLabel(
            tr(
                "about_details",
                author=AUTOR,
                organization=ORGANIZACION,
                license=LICENCIA_SPDX,
            )
        )
        detalles.setWordWrap(True)
        detalles.setTextFormat(Qt.RichText)
        detalles.setOpenExternalLinks(True)
        layout.addWidget(detalles)

        creditos = QLabel(tr("about_credits"))
        creditos.setWordWrap(True)
        creditos.setObjectName("informacion")
        layout.addWidget(creditos)
        layout.addStretch(1)
        return pagina

    def _crear_licencia(self):
        pagina = QWidget()
        layout = QVBoxLayout(pagina)

        resumen = QLabel(tr("license_summary"))
        resumen.setWordWrap(True)
        layout.addWidget(resumen)

        texto = QTextBrowser()
        texto.setReadOnly(True)
        try:
            contenido = self.ruta_licencia.read_text(
                encoding="utf-8"
            )
        except OSError:
            contenido = tr("license_file_unavailable")
        texto.setPlainText(contenido)
        layout.addWidget(texto, 1)
        return pagina

    def _crear_apoyo(self):
        pagina = QWidget()
        layout = QVBoxLayout(pagina)

        invitacion = QLabel(tr("support_description"))
        invitacion.setWordWrap(True)
        layout.addWidget(invitacion)

        contacto = QLabel(
            tr("support_contact", email=CORREO_APOYO)
        )
        contacto.setTextInteractionFlags(
            Qt.TextSelectableByMouse
        )
        contacto.setWordWrap(True)
        layout.addWidget(contacto)

        acciones = QHBoxLayout()
        copiar = QPushButton(tr("copy_support_email"))
        copiar.clicked.connect(self._copiar_correo)
        acciones.addWidget(copiar)

        paypal = QPushButton(tr("donate_with_paypal"))
        paypal.setEnabled(bool(URL_DONATIVOS))
        paypal.clicked.connect(self._abrir_paypal)
        if not URL_DONATIVOS:
            paypal.setToolTip(tr("paypal_link_pending"))
        acciones.addWidget(paypal)
        acciones.addStretch(1)
        layout.addLayout(acciones)

        if not URL_DONATIVOS:
            pendiente = QLabel(tr("paypal_link_pending"))
            pendiente.setWordWrap(True)
            pendiente.setObjectName("informacion")
            layout.addWidget(pendiente)

        self.estado_copia = QLabel("")
        layout.addWidget(self.estado_copia)
        layout.addStretch(1)
        return pagina

    def _copiar_correo(self):
        QApplication.clipboard().setText(CORREO_APOYO)
        self.estado_copia.setText(tr("support_email_copied"))

    def _abrir_paypal(self):
        if URL_DONATIVOS:
            QDesktopServices.openUrl(QUrl(URL_DONATIVOS))
